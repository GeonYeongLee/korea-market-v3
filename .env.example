# ==============================================================================
# 한국투자증권 (KIS Developers) Open API 설정 파일 (.env) - Korea Market v3
# ==============================================================================

# 실행 모드: 'vts' (모의투자) 또는 'real' (실전투자)
KIS_ENV=vts
KIS_IS_VIRTUAL=true

# ------------------------------------------------------------------------------
# [방법 A] 모의투자 / 실전투자 분리 지정 (권장: nq-trade 호환 형식)
# ------------------------------------------------------------------------------
# 1. 모의투자 (VTS)
KIS_VTS_APP_KEY=your_vts_app_key_here
KIS_VTS_APP_SECRET=your_vts_app_secret_here
KIS_VTS_CANO=12345678
KIS_VTS_ACNT_PRDT_CD=01

# 2. 실전투자 (Real)
KIS_REAL_APP_KEY=your_real_app_key_here
KIS_REAL_APP_SECRET=your_real_app_secret_here
KIS_REAL_CANO=87654321
KIS_REAL_ACNT_PRDT_CD=01

# ------------------------------------------------------------------------------
# [방법 B] 단일 환경 직접 지정 (하위 호환)
# ------------------------------------------------------------------------------
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRDT_CD=01

# HTS ID (WebSocket 실시간 체결통보 H0STCNI0/H0STCNI9 및 조건검색 조회 시 필요)
KIS_HTS_ID=your_hts_user_id

# 알림 설정 (선택사항)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# 로깅 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
